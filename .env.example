# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Supabase — Project Settings > Data API, and Project Settings > API Keys
# URL must be the bare project origin. No trailing /rest/v1.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key. Safe in the browser ONLY because Row Level Security is on
# for every table. Never disable RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret key. Bypasses RLS entirely. Server-only.
# NEVER rename this to start with NEXT_PUBLIC_ — that ships it to the browser
# and exposes every student record.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Groq — console.groq.com. Used for match explanations only; the app degrades
# gracefully without it.
GROQ_API_KEY=gsk_xxx

# Hugging Face — fine-grained token with "Make calls to Inference Providers".
HUGGINGFACE_API_TOKEN=hf_xxx

NEXT_PUBLIC_APP_URL=http://localhost:3000
